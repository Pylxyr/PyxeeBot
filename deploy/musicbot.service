[Unit]
Description=Discord MusicBot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/musicbot
Environment="PATH=/home/ubuntu/musicbot/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="PYTHONMALLOC=malloc"
Environment="MALLOC_TRIM_THRESHOLD_=65536"
EnvironmentFile=/home/ubuntu/musicbot/.env
ExecStart=/home/ubuntu/musicbot/.venv/bin/python bot.py
Nice=-10
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
SyslogIdentifier=musicbot
MemoryHigh=600M
MemoryMax=700M
OOMScoreAdjust=-500
LimitNOFILE=65536
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=read-only
# Only data/ and logs/ are writable under ProtectHome=read-only — anything the
# app needs to persist (the sqlite DB, Twitch's OAuth token file at
# data/twitch_tokens.json, cookies.txt if used) has to live under one of
# these two paths or writes will silently fail with a read-only filesystem
# error. See musicbot/config.py's DATA_DIR / twitch_token_path.
ReadWritePaths=/home/ubuntu/musicbot/data /home/ubuntu/musicbot/logs
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# Blocks writable+executable memory mappings, which breaks JIT-based
# JavaScript runtimes (Node.js/V8, Bun) with a SIGSYS crash if yt-dlp is ever
# pointed at one via YTDLP_JS_RUNTIME_PATH. Deno (the default/recommended
# runtime — see deploy/_common.sh and .env.example) runs JIT-less and is not
# affected; this only bites if you deliberately switch to Node or Bun.
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
