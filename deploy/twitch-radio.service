[Unit]
Description=Twitch Radio Bot
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/twitch-radio-bot
Environment="PATH=/home/ubuntu/twitch-radio-bot/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="PYTHONMALLOC=malloc"
# ProtectHome=read-only below blocks Deno's default cache dir (normally
# under $HOME/.cache/deno) — redirected under data/, the one place this
# unit can actually write, so it doesn't need to fall back to re-fetching/
# recompiling on every run. Harmless if Node/Bun/QuickJS is used instead.
Environment="DENO_DIR=/home/ubuntu/twitch-radio-bot/data/deno-cache"
EnvironmentFile=/home/ubuntu/twitch-radio-bot/.env
ExecStart=/home/ubuntu/twitch-radio-bot/.venv/bin/python /home/ubuntu/twitch-radio-bot/bot.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
OOMScoreAdjust=-100
LimitNOFILE=65536

# No MemoryDenyWriteExecute and no SystemCallFilter: yt-dlp needs a working
# V8 JS runtime (Deno by default) for YouTube, and both directives break it.
# MDWE: Deno panics on ENOMEM on its very first script under it.
# SystemCallFilter=@system-service: confirmed directly under this exact unit
# — Deno's JS-challenge solver died with SIGSYS (-31) under it, surfacing as
# an unrelated-looking yt-dlp error ("Requested format is not available").
# Worked outside systemd, and under systemd-run without this directive.
# Both would break song requests outright, so both stay off.
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=read-only
# Only data/ and logs/ are writable — everything this process persists
# (tokens, tunables) lives under data/.
ReadWritePaths=/home/ubuntu/twitch-radio-bot/data /home/ubuntu/twitch-radio-bot/logs
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
